# ── AiSearch — konfiguracja (skopiuj do .env; .env NIGDY do gita) ────

# ── stan silnika ───────────────────────────────────────────────────
# Katalog cache/prior/linklog. Domyślnie .cache/web w repo.
WEB_CACHE_DIR=

# ── producent kandydatów ───────────────────────────────────────────
# inline = własne URL-e (0 kosztów) · feeds = RSS/Atom · prior = nauka z linklogu
# llm = zewnętrzny proposer (opcjonalny; bez niego też działa)
WEB_PROPOSERS=inline,feeds,prior
# WEB_LLM_URL=            # np. http://127.0.0.1:11434/v1
# WEB_LLM_KEY=
# WEB_LLM_MODEL=

# ── własne źródła (intencja local-pl) ──────────────────────────────
# WEB_SOURCE_LOCAL=twoja-domena.pl,blog.twoja-domena.pl

# ── escape hatch SERP ──────────────────────────────────────────────
WEB_SERP_ENABLED=true          # false = nigdy nie uciekaj do SERP
WEB_SERP_PROVIDER=ddg-html     # ddg-html | bing-html | searxng
# WEB_SERP_ENDPOINT=          # własna instancja searxng
# WEB_SERP_KEY=

# ── budżety i limity ───────────────────────────────────────────────
WEB_MAX_REQUESTS=24            # twardy budżet requestów na zapytanie
WEB_CONCURRENCY=6              # równoległe kandydaci (1-16)
WEB_TIMEOUT_MS=10000           # timeout jednego fetcha

# ── progi scoringu ─────────────────────────────────────────────────
WEB_COVERAGE_THRESHOLD=0.35    # poniżej = escape hatch do SERP

# ── cache (TTL) ────────────────────────────────────────────────────
WEB_CACHE_RESOLVE_TTL_MS=21600000      # 6 h (negatywy 15 min)
WEB_CACHE_CONTENT_TTL_MS=86400000      # 24 h
WEB_CACHE_CONTENT_MAX=2000             # LRU
WEB_FEED_REFRESH_MS=1800000            # 30 min

# ── nauka / drift ──────────────────────────────────────────────────
WEB_LEARN_WINDOW=5000          # ile wpisów linklogu wchodzi do prioru
WEB_DRIFT_REDIRECT_RATIO=0.25  # próg alarmu driftu dokumentacji
WEB_WAYBACK_ENABLED=true       # ocalać martwe linki przez Wayback

# ── renderowanie (przeglądarka Obscura) ────────────────────────────
# auto (domyślnie) = renderuj tylko gdy treść < progu (JS-shell)
# all = każdy zweryfikowany wynik (drogo) · off = nigdy
WEB_RENDER=auto
OBSCURA_BIN=                   # ścieżka do obscura.exe; puste = szukaj w bin/ i PATH
OBSCURA_STEALTH=0              # 1 = --stealth
WEB_RENDER_MIN_TEXT=200        # poniżej tylu znaków treści = podejrzany JS-shell
WEB_RENDER_MAX=3               # budżet renderów na zapytanie
WEB_RENDER_TIMEOUT_MS=15000    # timeout jednej strony

# ── warstwa HTTP ───────────────────────────────────────────────────
WEB_HTTP_HOST=127.0.0.1
WEB_HTTP_PORT=8787
# WEB_API_KEY=                 # pusty = bez auth (tylko loopback!)
WEB_RATE_LIMIT=60              # zapytań / 60 s / IP

# ── warstwa MCP (stdio) ────────────────────────────────────────────
# Serwer nie potrzebuje konfiguracji — wystarczy go zarejestrować u klienta:
#   {"mcpServers":{"aisearch":{"command":"node","args":["<repo>/src/mcp/server.mjs"]}}}
